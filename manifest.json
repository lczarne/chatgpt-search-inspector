{
  "manifest_version": 3,
  "name": "ChatGPT Search Inspector",
  "description": "Local inspector for search queries and sources visible in the ChatGPT stream.",
  "version": "0.2.3",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "sidePanel",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Search Inspector"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "host_permissions": [
    "https://chatgpt.com/*"
  ]
}
